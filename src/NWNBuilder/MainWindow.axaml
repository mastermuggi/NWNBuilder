<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:NWNBuilder"
        xmlns:core="using:NWNBuilder.Core"
        xmlns:m="using:NWNBuilder.Core.Models"
        xmlns:sys="using:System"
        x:Class="NWNBuilder.MainWindow"
        Title="NWNBuilder"
        Width="1320" Height="860" MinWidth="1000" MinHeight="640"
        Background="{StaticResource AppBackground}">

  <Grid RowDefinitions="Auto,*">

    <!-- Topbar -->
    <Border Grid.Row="0" Background="{StaticResource SidebarBackground}"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock VerticalAlignment="Center" FontSize="20">
          <Run Text="NWN" FontWeight="Bold" Foreground="{StaticResource Gold}" />
          <Run Text="Builder" FontWeight="Light" />
        </TextBlock>
        <TextBlock Grid.Column="1" x:Name="StatusText" Text="Ikke forbundet"
                   Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                   Margin="24,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="+ Nyt build" Click="New_Click" />
          <Button Content="Gem" Classes="accent" Click="Save_Click" MinWidth="80" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="270,*">

      <!-- Sidebar -->
      <Border Background="{StaticResource SidebarBackground}"
              BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0" Padding="14">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="BUILDS" />
          <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Watermark="Søg…"
                   TextChanged="Search_TextChanged" Margin="0,0,0,10" />

          <!-- Database -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <TextBlock Classes="section" Text="DATABASE" Margin="0,0,0,2" />
            <TextBox x:Name="ConnectionBox" PasswordChar="•" Watermark="mongodb+srv://…" />
            <Button Content="Forbind" Click="Connect_Click" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button Content="Importér regelsæt…" Click="ImportRuleset_Click" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
          </StackPanel>

          <ListBox x:Name="BuildList" Background="Transparent"
                   SelectionChanged="BuildList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:Build">
                <StackPanel Margin="2,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Classes="label" Text="{Binding Race}" Margin="0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Editor -->
      <DockPanel Grid.Column="1" x:Name="Editor" x:DataType="core:BuildEditor" Margin="28,20,28,20">

        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBox Text="{Binding Build.Name}" Watermark="Navn" FontSize="30" FontWeight="SemiBold"
                   Background="Transparent" BorderThickness="0" Padding="0" />
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding ClassSplit}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <Border Classes="chip" Margin="0,0,8,0">
                    <TextBlock Text="{Binding}" Foreground="{StaticResource Gold}" FontSize="12" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <TabControl SelectionChanged="Tabs_SelectionChanged">

          <!-- Oversigt -->
          <TabItem Header="Oversigt">
            <ScrollViewer>
              <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,20,Auto" Margin="0,12,0,0">

                <Border Grid.Row="0" Grid.Column="0" Classes="card">
                  <StackPanel>
                    <TextBlock Classes="section" Text="KARAKTER" />
                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,12,Auto,12,Auto">
                      <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Classes="label" Text="Race" />
                        <TextBox Text="{Binding Build.Race}" />
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Classes="label" Text="Alignment" />
                        <ComboBox ItemsSource="{x:Static local:Options.Alignments}"
                                  SelectedItem="{Binding Build.Alignment}" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Classes="label" Text="Gud" />
                        <TextBox Text="{Binding Build.Deity}" />
                      </StackPanel>
                      <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Classes="label" Text="Alder" />
                        <TextBox Text="{Binding Build.Age}" />
                      </StackPanel>
                      <StackPanel Grid.Row="4" Grid.Column="0">
                        <TextBlock Classes="label" Text="Regelsæt" />
                        <ComboBox ItemsSource="{x:Static local:Options.Rulesets}"
                                  SelectedItem="{Binding Build.Ruleset}" HorizontalAlignment="Stretch" />
                      </StackPanel>
                      <TextBlock Grid.Row="4" Grid.Column="2" Classes="label" Text="{Binding RulesetText}"
                                 TextWrapping="Wrap" VerticalAlignment="Bottom" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Classes="card">
                  <StackPanel>
                    <TextBlock Classes="section" Text="STATS" />
                    <Grid ColumnDefinitions="90,*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="STR" HorizontalAlignment="Center" />
                      <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="DEX" HorizontalAlignment="Center" />
                      <TextBlock Grid.Row="0" Grid.Column="3" Classes="label" Text="CON" HorizontalAlignment="Center" />
                      <TextBlock Grid.Row="0" Grid.Column="4" Classes="label" Text="INT" HorizontalAlignment="Center" />
                      <TextBlock Grid.Row="0" Grid.Column="5" Classes="label" Text="WIS" HorizontalAlignment="Center" />
                      <TextBlock Grid.Row="0" Grid.Column="6" Classes="label" Text="CHA" HorizontalAlignment="Center" />

                      <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Point-buy" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="1" Classes="ability" Margin="0,0,6,0" Text="{Binding Build.StartAbilities.Str}" />
                      <TextBox Grid.Row="1" Grid.Column="2" Classes="ability" Margin="0,0,6,0" Text="{Binding Build.StartAbilities.Dex}" />
                      <TextBox Grid.Row="1" Grid.Column="3" Classes="ability" Margin="0,0,6,0" Text="{Binding Build.StartAbilities.Con}" />
                      <TextBox Grid.Row="1" Grid.Column="4" Classes="ability" Margin="0,0,6,0" Text="{Binding Build.StartAbilities.Int}" />
                      <TextBox Grid.Row="1" Grid.Column="5" Classes="ability" Margin="0,0,6,0" Text="{Binding Build.StartAbilities.Wis}" />
                      <TextBox Grid.Row="1" Grid.Column="6" Classes="ability" Text="{Binding Build.StartAbilities.Cha}" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Start" VerticalAlignment="Center" Margin="0,12,0,0" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="stat" Text="{Binding StartWithGifts.Str}" />
                      <TextBlock Grid.Row="2" Grid.Column="2" Classes="stat" Text="{Binding StartWithGifts.Dex}" />
                      <TextBlock Grid.Row="2" Grid.Column="3" Classes="stat" Text="{Binding StartWithGifts.Con}" />
                      <TextBlock Grid.Row="2" Grid.Column="4" Classes="stat" Text="{Binding StartWithGifts.Int}" />
                      <TextBlock Grid.Row="2" Grid.Column="5" Classes="stat" Text="{Binding StartWithGifts.Wis}" />
                      <TextBlock Grid.Row="2" Grid.Column="6" Classes="stat" Text="{Binding StartWithGifts.Cha}" />

                      <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Slut" VerticalAlignment="Center" Margin="0,12,0,0" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Classes="stat gold" Text="{Binding Final.Abilities.Str}" />
                      <TextBlock Grid.Row="3" Grid.Column="2" Classes="stat gold" Text="{Binding Final.Abilities.Dex}" />
                      <TextBlock Grid.Row="3" Grid.Column="3" Classes="stat gold" Text="{Binding Final.Abilities.Con}" />
                      <TextBlock Grid.Row="3" Grid.Column="4" Classes="stat gold" Text="{Binding Final.Abilities.Int}" />
                      <TextBlock Grid.Row="3" Grid.Column="5" Classes="stat gold" Text="{Binding Final.Abilities.Wis}" />
                      <TextBlock Grid.Row="3" Grid.Column="6" Classes="stat gold" Text="{Binding Final.Abilities.Cha}" />
                    </Grid>
                    <TextBlock Classes="label" Margin="0,10,0,0"
                               Text="Point-buy er før race og gifts. Start = med race og gifts. Slut = efter sidste level." />
                  </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Classes="card">
                  <StackPanel>
                    <TextBlock Classes="section" Text="GIFTS" />
                    <ItemsControl ItemsSource="{Binding Gifts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:GiftOption">
                          <CheckBox IsChecked="{Binding IsSelected}" Click="Gift_Click" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Text="{Binding Effect}" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Classes="card" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Classes="section" Text="{Binding Final.Level, StringFormat='RESULTAT VED LEVEL {0}'}" />
                    <UniformGrid Columns="5">
                      <StackPanel>
                        <TextBlock Classes="label" Text="BAB" HorizontalAlignment="Center" />
                        <TextBlock Classes="stat gold" Text="{Binding Final.Bab}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Classes="label" Text="HP" HorizontalAlignment="Center" />
                        <TextBlock Classes="stat gold" Text="{Binding Final.Hp}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Classes="label" Text="FORT" HorizontalAlignment="Center" />
                        <TextBlock Classes="stat gold" Text="{Binding Final.Fort}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Classes="label" Text="REF" HorizontalAlignment="Center" />
                        <TextBlock Classes="stat gold" Text="{Binding Final.Ref}" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Classes="label" Text="WILL" HorizontalAlignment="Center" />
                        <TextBlock Classes="stat gold" Text="{Binding Final.Will}" />
                      </StackPanel>
                    </UniformGrid>
                    <TextBlock Classes="label" Text="{Binding SkillPointsText}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding WarningsText}" Foreground="#E07A5F" TextWrapping="Wrap" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </ScrollViewer>
          </TabItem>

          <!-- Levels -->
          <TabItem Header="Levels">
            <Border Classes="card" Padding="0" Margin="0,12,0,0">
              <DataGrid x:CompileBindings="False" ItemsSource="{Binding Rows}"
                        AutoGenerateColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" IsReadOnly="True" Width="50" />
                  <DataGridTextColumn Header="Klasse" Binding="{Binding Class}" Width="140" />
                  <DataGridTextColumn Header="Class feat" Binding="{Binding ClassFeat}" Width="*" />
                  <DataGridTextColumn Header="General feat" Binding="{Binding GeneralFeat}" Width="*" />
                  <DataGridTemplateColumn Header="Ability +1" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:CompileBindings="False">
                        <ComboBox ItemsSource="{x:Static local:Options.AbilityChoices}"
                                  SelectedItem="{Binding AbilityIncrease, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="BAB" Binding="{Binding Bab}" IsReadOnly="True" Width="52" />
                  <DataGridTextColumn Header="F" Binding="{Binding Fort}" IsReadOnly="True" Width="44" />
                  <DataGridTextColumn Header="R" Binding="{Binding Ref}" IsReadOnly="True" Width="44" />
                  <DataGridTextColumn Header="W" Binding="{Binding Will}" IsReadOnly="True" Width="44" />
                  <DataGridTextColumn Header="HP" Binding="{Binding Hp}" IsReadOnly="True" Width="52" />
                  <DataGridTextColumn Header="SP" Binding="{Binding SkillPoints}" IsReadOnly="True" Width="48" />
                  <DataGridTextColumn Header="STR" Binding="{Binding Str}" IsReadOnly="True" Width="48" />
                  <DataGridTextColumn Header="DEX" Binding="{Binding Dex}" IsReadOnly="True" Width="48" />
                  <DataGridTextColumn Header="CON" Binding="{Binding Con}" IsReadOnly="True" Width="48" />
                  <DataGridTextColumn Header="INT" Binding="{Binding Int}" IsReadOnly="True" Width="48" />
                  <DataGridTextColumn Header="WIS" Binding="{Binding Wis}" IsReadOnly="True" Width="48" />
                  <DataGridTextColumn Header="CHA" Binding="{Binding Cha}" IsReadOnly="True" Width="48" />
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </TabItem>

          <!-- Skills & crafting -->
          <TabItem Header="Skills &amp; crafting">
            <Grid ColumnDefinitions="3*,20,2*" Margin="0,12,0,0">

              <Border Grid.Column="0" Classes="card">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="section" Text="SKILL RANKS" />
                  <TextBlock DockPanel.Dock="Top" Classes="label" Text="{Binding SkillPointsText}" Margin="0,-6,0,8" />
                  <Button DockPanel.Dock="Bottom" Content="+ Tilføj skill" Click="AddSkill_Click" Margin="0,10,0,0" />
                  <DataGrid x:CompileBindings="False" ItemsSource="{Binding Skills}"
                            AutoGenerateColumns="False" CanUserReorderColumns="False"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Skill" Binding="{Binding Name}" Width="*" />
                      <DataGridTextColumn Header="Point" Binding="{Binding Points}" Width="70" />
                      <DataGridTextColumn Header="Class" Binding="{Binding ClassSkill}" IsReadOnly="True" Width="64" />
                      <DataGridTextColumn Header="Ranks" Binding="{Binding Ranks}" IsReadOnly="True" Width="64" />
                      <DataGridTextColumn Header="Mod" Binding="{Binding Modifier}" IsReadOnly="True" Width="56" />
                      <DataGridTextColumn Header="Total" Binding="{Binding Total}" IsReadOnly="True" Width="60" />
                      <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Button Content="✕" Click="RemoveRow_Click" Background="Transparent"
                                    Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>

              <Border Grid.Column="2" Classes="card">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="section" Text="CRAFTING" />
                  <Button DockPanel.Dock="Bottom" Content="+ Tilføj craft" Click="AddCraft_Click" Margin="0,10,0,0" />
                  <DataGrid x:CompileBindings="False" ItemsSource="{Binding Crafting}"
                            AutoGenerateColumns="False" CanUserReorderColumns="False"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Craft" Binding="{Binding Name}" Width="*" />
                      <DataGridTextColumn Header="Point" Binding="{Binding Value}" Width="90" />
                      <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Button Content="✕" Click="RemoveRow_Click" Background="Transparent"
                                    Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>

          <!-- Rollespil -->
          <TabItem Header="Rollespil">
            <ScrollViewer>
              <StackPanel Spacing="20" Margin="0,12,0,0">
                <Border Classes="card">
                  <StackPanel>
                    <TextBlock Classes="section" Text="NOTER" />
                    <TextBox Text="{Binding Build.Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" />
                  </StackPanel>
                </Border>
                <Border Classes="card">
                  <StackPanel>
                    <TextBlock Classes="section" Text="BAGGRUND" />
                    <TextBox Text="{Binding Build.Background}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="320" FontSize="14" LineHeight="22" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- Venner -->
          <TabItem Header="Venner">
            <Border Classes="card" Margin="0,12,0,0">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="section" Text="VENNEBOG" />
                <Button DockPanel.Dock="Bottom" Content="+ Tilføj ven" Click="AddFriend_Click" Margin="0,10,0,0" />
                <DataGrid x:CompileBindings="False" ItemsSource="{Binding Friends}"
                          AutoGenerateColumns="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="220" />
                    <DataGridTextColumn Header="Spiller" Binding="{Binding PlayerName}" Width="220" />
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                    <DataGridTemplateColumn Width="50">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Button Content="✕" Click="RemoveRow_Click" Background="Transparent"
                                  Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </TabItem>

        </TabControl>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
